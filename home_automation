PROGRAM CODE:

File 1: Backend Server (app.py)
Save as app.py in ~/home_automation:

from flask import Flask, render_template, redirect, url_for
import RPi.GPIO as GPIO

app = Flask(__name__)

RELAYS = {
    1: {"name": "Living Room Light", "pin": 17, "state": "OFF"},
    2: {"name": "Ceiling Fan",       "pin": 27, "state": "OFF"},
    3: {"name": "Kitchen Outlet",    "pin": 22, "state": "OFF"},
    4: {"name": "Porch Lamp",        "pin": 23, "state": "OFF"}
}

GPIO.setmode(GPIO.BCM)
GPIO.setwarnings(False)

for r in RELAYS.values():
    GPIO.setup(r["pin"], GPIO.OUT)
    GPIO.output(r["pin"], GPIO.HIGH)

@app.route("/")
def index():
    return render_template("index.html", relays=RELAYS)

@app.route("/toggle/<int:relay_id>/<action>")
def toggle_relay(relay_id, action):
    if relay_id in RELAYS:
        pin = RELAYS[relay_id]["pin"]
        if action == "on":
            GPIO.output(pin, GPIO.LOW)
            RELAYS[relay_id]["state"] = "ON"
        elif action == "off":
            GPIO.output(pin, GPIO.HIGH)
            RELAYS[relay_id]["state"] = "OFF"
    return redirect(url_for("index"))

@app.route("/all/<action>")
def toggle_all(action):
    for r in RELAYS.values():
        if action == "on":
            GPIO.output(r["pin"], GPIO.LOW)
            r["state"] = "ON"
        elif action == "off":
            GPIO.output(r["pin"], GPIO.HIGH)
            r["state"] = "OFF"
    return redirect(url_for("index"))

if __name__ == "__main__":
    try:
        app.run(host="0.0.0.0", port=5000, debug=False)
    finally:
        GPIO.cleanup()


